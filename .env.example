# Copy to .env and fill in. Never commit .env.
EIA_API_KEY=
SMART_GRID_ROOT=

# DagsHub MLflow (optional). If unset, logs go to local ./mlflow.db
# URI looks like: https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_URI= 
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
DAGSHUB_TOKEN=

# Optional. If set, FastAPI requires header X-API-Key (except GET /health).
API_KEY=

# Streamlit → FastAPI
SMART_GRID_API_URL=http://127.0.0.1:8000

# Docker Hub image prefix (docker compose / publish)
DOCKERHUB_USER=
TAG=latest
